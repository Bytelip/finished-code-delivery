# =================================================================
# AgroSpace Nexus - Production Authentication Configuration
# =================================================================

# -----------------------------------------------------------------
# 1. Supabase Authentication (Primary / Recommended)
# Supports Google, Microsoft, Apple OAuth & 6-Digit Email OTP
# -----------------------------------------------------------------
# Get your project URL and Anon key from https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# -----------------------------------------------------------------
# 2. Standalone OAuth Client IDs (Fallback if Supabase is unconfigured)
# -----------------------------------------------------------------
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8080/auth (or your live domain /auth)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Microsoft Entra ID / Azure Portal: https://portal.azure.com/#blade/Microsoft_AAD_IAM/ActiveDirectoryMenuBlade/RegisteredApps
VITE_MICROSOFT_CLIENT_ID=your_microsoft_application_client_id

# Apple Developer Portal: https://developer.apple.com/account/resources/identifiers/list/serviceId
VITE_APPLE_CLIENT_ID=your_apple_service_id

# -----------------------------------------------------------------
# 3. EmailJS Configuration (For direct browser email OTP delivery)
# https://www.emailjs.com
# -----------------------------------------------------------------
# 1. Service ID from "Email Services" tab (e.g., service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=your_service_id

# 2. Template ID from "Email Templates" tab (e.g., template_xxxxxxx)
# Ensure template includes {{to_email}}, {{verification_code}}, {{app_name}}
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# 3. Public Key from "Account" -> "API Keys" -> Public Key (e.g., xxxxxxxxxxxxxxx)
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# -----------------------------------------------------------------
# 4. Resend API Configuration (Fastest 1-Key Email API)
# https://resend.com
# -----------------------------------------------------------------
VITE_RESEND_API_KEY=re_your_resend_api_key

# -----------------------------------------------------------------
# 5. SendGrid API Configuration (Enterprise Email Delivery)
# https://sendgrid.com
# -----------------------------------------------------------------
VITE_SENDGRID_API_KEY=SG.your_sendgrid_api_key
VITE_SENDGRID_FROM_EMAIL=no-reply@yourverifieddomain.com

# -----------------------------------------------------------------
# 6. Twilio SMS Configuration (Fallback Verification Channel)
# https://www.twilio.com
# -----------------------------------------------------------------
VITE_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token
VITE_TWILIO_PHONE_NUMBER=+1234567890
