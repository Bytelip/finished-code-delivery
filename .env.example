# =================================================================
# AgroSpace Nexus - Environment Configuration
# =================================================================

# EmailJS Service Configuration (for real 6-digit OTP delivery to Gmail/Inbox)
# Get your free credentials from: https://www.emailjs.com
# 1. Service ID from "Email Services" tab (e.g., service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=your_service_id

# 2. Template ID from "Email Templates" tab (e.g., template_xxxxxxx)
# Ensure template includes {{to_email}}, {{verification_code}}, {{app_name}}
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# 3. Public Key from "Account" -> "API Keys" -> Public Key (e.g., xxxxxxxxxxxxxxx)
VITE_EMAILJS_PUBLIC_KEY=your_public_key
